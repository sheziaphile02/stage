// ── MAIN APP ─────────────────────────────────────────────
export default function StageApp() {
  const [mode, setMode] = useState("presentation");

  // ── Presentation
  const [slides, setSlides] = useState(DEF_SLIDES);
  const [curSlide, setCurSlide] = useState(0);
  const [presNotes, setPresNotes] = useState(DEF_SLIDES[0].notes);
  const [presBg, setPresBg] = useState(null);
  const [timerSec, setTimerSec] = useState(0);
  const [timerOn, setTimerOn] = useState(false);
  const timerRef = useRef(null);

  // ── Music
  const [songs, setSongs] = useState(DEF_SONGS);
  const [curSong, setCurSong] = useState(DEF_SONGS[0]);
  const [songTitle, setSongTitle] = useState(DEF_SONGS[0].title);
  const [lyricsText, setLyricsText] = useState(DEF_SONGS[0].lyrics);
  const [speed, setSpeed] = useState(3);
  const [playing, setPlaying] = useState(false);
  const [lyricIdx, setLyricIdx] = useState(0);
  const [musicBg, setMusicBg] = useState(null);
  const [beats, setBeats] = useState([20, 35, 15, 45, 25, 30, 20, 40]);
  const lyricRef = useRef(null);
  const beatRef = useRef(null);
  const [libraryLoaded, setLibraryLoaded] = useState(false);

  // ── Bible
  const [bibleQuery, setBibleQuery] = useState("John 3:16");
  const [bibleVersion, setBibleVersion] = useState("web");
  const [bibleVerse, setBibleVerse] = useState(null);
  const [bibleLoading, setBibleLoading] = useState(false);
  const [bibleError, setBibleError] = useState("");
  const [recentVerses, setRecentVerses] = useState([]);
  const [bibleBg, setBibleBg] = useState(null);

  // ── Fullscreen
  const [fullscreen, setFullscreen] = useState(false);

  // ─── Load song library from storage
  useEffect(() => {
    async function load() {
      try {
        const r = await window.storage.get("stage-songs");
        if (r && r.value) {
          const saved = JSON.parse(r.value);
          if (Array.isArray(saved) && saved.length) setSongs(saved);
        }
      } catch {}
      setLibraryLoaded(true);
    }
    load();
  }, []);

  // ─── Save songs to storage whenever they change
  useEffect(() => {
    if (!libraryLoaded) return;
    window.storage.set("stage-songs", JSON.stringify(songs)).catch(() => {});
  }, [songs, libraryLoaded]);

  // ─── Timer
  useEffect(() => {
    if (timerOn) timerRef.current = setInterval(() => setTimerSec(s => s + 1), 1000);
    else clearInterval(timerRef.current);
    return () => clearInterval(timerRef.current);
  }, [timerOn]);

  const fmt = s => `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;

  // ─── Slide helpers
  const goSlide = i => { setCurSlide(i); setPresNotes(slides[i]?.notes || ""); };
  const updateSlide = (f, v) => setSlides(sl => sl.map((s, i) => i === curSlide ? { ...s, [f]: v } : s));
  const addSlide = () => {
    const ns = { id: Date.now(), title: `Slide ${slides.length + 1}`, body: "Your content here", notes: "" };
    setSlides(s => [...s, ns]);
  };
  const delSlide = () => {
    if (slides.length <= 1) return;
    const next = slides.filter((_, i) => i !== curSlide);
    setSlides(next);
    setCurSlide(Math.min(curSlide, next.length - 1));
  };

  // ─── Karaoke helpers
  const parsedLines = lyricsText.split("\n").map(l => l.trim());

  const startKaraoke = () => {
    if (playing) {
      setPlaying(false);
      clearInterval(lyricRef.current);
      clearInterval(beatRef.current);
      return;
    }
    setPlaying(true);
    setLyricIdx(0);
    const ms = Math.max(700, 4500 - speed * 550);
    lyricRef.current = setInterval(() => {
      setLyricIdx(i => {
        if (i >= parsedLines.length - 1) {
          setPlaying(false);
          clearInterval(lyricRef.current);
          clearInterval(beatRef.current);
          return i;
        }
        return i + 1;
      });
    }, ms);
    beatRef.current = setInterval(() => {
      setBeats(Array.from({ length: 8 }, () => Math.random() * 28 + 4));
    }, 200);
  };

  useEffect(() => () => { clearInterval(lyricRef.current); clearInterval(beatRef.current); }, []);

  const loadSong = song => {
    setPlaying(false);
    clearInterval(lyricRef.current);
    clearInterval(beatRef.current);
    setCurSong(song);
    setSongTitle(song.title);
    setLyricsText(song.lyrics);
    setLyricIdx(0);
  };

  const saveSong = () => {
    const existing = songs.find(s => s.title.toLowerCase() === songTitle.toLowerCase());
    if (existing) {
      setSongs(s => s.map(x => x.id === existing.id ? { ...x, lyrics: lyricsText } : x));
    } else {
      setSongs(s => [...s, { id: Date.now(), title: songTitle, lyrics: lyricsText }]);
    }
  };

  const deleteSong = id => setSongs(s => s.filter(x => x.id !== id));

  // ─── Bible fetch
  const fetchVerse = async (ref) => {
    if (!ref.trim()) return;
    setBibleLoading(true);
    setBibleError("");
    setBibleVerse(null);
    try {
      const r = await fetch(`https://bible-api.com/${encodeURIComponent(ref)}?translation=${bibleVersion}`);
      const d = await r.json();
      if (d.error) throw new Error(d.error);
      const verse = { text: d.text.trim(), reference: d.reference };
      setBibleVerse(verse);
      setRecentVerses(rv => {
        const filtered = rv.filter(x => x.reference !== verse.reference);
        return [verse, ...filtered].slice(0, 8);
      });
    } catch (e) {
      setBibleError("Verse not found. Try: John 3:16 or Romans 8:28");
    }
    setBibleLoading(false);
  };

  // ─── Background image upload
  const handleBgUpload = (setter) => (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => setter(ev.target.result);
    reader.readAsDataURL(file);
  };

  // ─── Lyric classes
  const lClass = i => {
    const d = i - lyricIdx;
    if (d < 0) return "lyric-row past";
    if (d === 0) return "lyric-row current";
    if (d === 1) return "lyric-row next";
    return "lyric-row far";
  };

  const visLines = parsedLines.map((l, i) => ({ l, i })).filter(({ i }) => {
    const d = i - lyricIdx;
    return d >= -2 && d <= 5;
  });

  const isSection = l => l.startsWith("[") && l.endsWith("]");
  const progress = parsedLines.length > 1 ? (lyricIdx / (parsedLines.length - 1)) * 100 : 0;

  // ─── Fullscreen display content
  const renderDisplay = () => {
    if (mode === "presentation") {
      const sl = slides[curSlide] || {};
      return (
        <DisplayPane bg={presBg} badge={`${curSlide + 1} / ${slides.length}`}>
          {sl.title && <div className="slide-title-out">{sl.title}</div>}
          {sl.title && sl.body && <div className="slide-gold-line" />}
          {sl.body && <div className="slide-body-out">{sl.body}</div>}
        </DisplayPane>
      );
    }
    if (mode === "music") {
      return (
        <DisplayPane bg={musicBg}>
          <div className="karaoke-wrap">
            {visLines.map(({ l, i }) => (
              isSection(l)
                ? <div key={i} className="lyric-section-tag">{l.slice(1, -1)}</div>
                : <div key={i} className={lClass(i)} onClick={() => setLyricIdx(i)}>{l || "\u00a0"}</div>
            ))}
          </div>
        </DisplayPane>
      );
    }
    if (mode === "bible") {
      return (
        <DisplayPane bg={bibleBg}>
          {bibleLoading && <div className="loading-dots"><div className="dot"/><div className="dot"/><div className="dot"/></div>}
          {bibleVerse && !bibleLoading && (
            <>
              <div className="verse-out">"{bibleVerse.text}"</div>
              <div className="verse-ref">— {bibleVerse.reference}</div>
            </>
          )}
          {!bibleVerse && !bibleLoading && (
            <div className="verse-idle">
              <div className="verse-idle-icon">✝</div>
              <div className="verse-idle-text">Search a Bible verse</div>
              <div className="verse-idle-sub">Type a reference and press Enter</div>
            </div>
          )}
        </DisplayPane>
      );
    }
  };

  const BgUploader = ({ bg, setter, label }) => (
    <div className="gap6">
      <div className="section-label">{label || "Background Image"}</div>
      <label className="bg-thumb" style={{ cursor: "pointer" }}>
        {bg ? <><img src={bg} alt="bg" /><button className="bg-clear" onClick={e => { e.preventDefault(); setter(null); }}>✕</button></> : <span>+ Upload Image</span>}
        <input type="file" accept="image/*" style={{ display: "none" }} onChange={handleBgUpload(setter)} />
      </label>
    </div>
  );

  return (
    <>
      <style>{css}</style>
      <div className="app">

        {/* ── FULLSCREEN OVERLAY ── */}
        {fullscreen && (
          <>
            <div className="fs-stage">{renderDisplay()}</div>
            <button className="fs-exit" onClick={() => setFullscreen(false)}>✕ Exit Fullscreen</button>
          </>
        )}

        {/* ── HEADER ── */}
        <div className="header">
          <div className="logo">STAGE</div>
          <div className="tabs">
            {["presentation","music","bible"].map(m => (
              <button key={m} className={`tab ${mode===m?"active":""}`} onClick={() => setMode(m)}>
                {m === "presentation" ? "⬛ Presentation" : m === "music" ? "♪ Music" : "✝ Bible"}
              </button>
            ))}
          </div>
          <div className="header-right">
            <button className="icon-btn" title="Fullscreen / Projector Output" onClick={() => setFullscreen(true)}>⛶</button>
          </div>
        </div>

        {/* ══════════════════════════════ PRESENTATION MODE */}
        {mode === "presentation" && (
          <div className="content">
            {/* Left — Slide List */}
            <div className="left-panel">
              <div className="panel-section">
                <div className="section-label">Slides</div>
                <div className="btn-row">
                  <button className="btn flex1" onClick={addSlide}>+ Add</button>
                  <button className="btn danger" onClick={delSlide}>Delete</button>
                </div>
              </div>
              <div className="slide-list">
                {slides.map((sl, i) => (
                  <div key={sl.id} className={`slide-item ${i===curSlide?"active":""}`} onClick={() => goSlide(i)}>
                    <div className="slide-item-num">#{String(i+1).padStart(2,"0")}</div>
                    <div className="slide-item-title">{sl.title || "Untitled"}</div>
                    <div className="slide-item-preview">{sl.body?.split("\n")[0]}</div>
                  </div>
                ))}
              </div>
            </div>

            {/* Centre — Stage */}
            <div className="stage">
              {renderDisplay()}
              <div className="stage-controls-bar">
                <button className="btn" onClick={() => goSlide(Math.max(0, curSlide-1))}>← Prev</button>
                <span className="small" style={{ minWidth: 70, textAlign: "center" }}>{curSlide+1} / {slides.length}</span>
                <button className="btn gold" onClick={() => goSlide(Math.min(slides.length-1, curSlide+1))}>Next →</button>
                <div style={{ flex: 1 }} />
                <button className="btn" onClick={() => setFullscreen(true)}>⛶ Projector</button>
              </div>
            </div>

            {/* Right — Controls */}
            <div className="right-panel">
              <div className="panel-section">
                <div className="section-label">Timer</div>
                <div className={`timer-big ${timerSec > 3600 ? "timer-warn" : ""}`}>{fmt(timerSec)}</div>
                <div className="btn-row">
                  <button className={`btn flex1 ${timerOn ? "gold" : ""}`} onClick={() => setTimerOn(!timerOn)}>{timerOn ? "⏸ Pause" : "▶ Start"}</button>
                  <button className="btn" onClick={() => { setTimerSec(0); setTimerOn(false); }}>↺</button>
                </div>
              </div>

              <div className="panel-section">
                <div className="section-label">Edit Slide</div>
                <div className="gap8">
                  <input className="inp" value={slides[curSlide]?.title||""} onChange={e => updateSlide("title", e.target.value)} placeholder="Title..." />
                  <textarea className="inp" rows={4} value={slides[curSlide]?.body||""} onChange={e => updateSlide("body", e.target.value)} placeholder="Content..." />
                </div>
              </div>

              <div className="panel-section">
                <BgUploader bg={presBg} setter={setPresBg} label="Slide Background" />
              </div>

              <div className="panel-section" style={{ flex: 1, display: "flex", flexDirection: "column" }}>
                <div className="section-label">Speaker Notes</div>
                <textarea className="inp flex1" style={{ flex: 1, resize: "none" }} value={presNotes}
                  onChange={e => { setPresNotes(e.target.value); updateSlide("notes", e.target.value); }}
                  placeholder="Private notes for this slide..." />
              </div>
            </div>
          </div>
        )}

        {/* ══════════════════════════════ MUSIC MODE */}
        {mode === "music" && (
          <div className="content">
            {/* Left — Library + Editor */}
            <div className="left-panel">
              <div className="panel-section">
                <div className="section-label">Song Library</div>
                <div className="btn-row mt8">
                  <button className="btn gold flex1" onClick={saveSong}>💾 Save Song</button>
                </div>
              </div>
              <div className="library-list">
                {songs.map(s => (
                  <div key={s.id} className={`song-item ${curSong?.id===s.id?"active":""}`} onClick={() => loadSong(s)}>
                    <span className="song-name">{s.title}</span>
                    <button className="song-del" onClick={e => { e.stopPropagation(); deleteSong(s.id); }}>✕</button>
                  </div>
                ))}
              </div>
              <div className="panel-section">
                <div className="section-label">Current Song</div>
                <div className="gap8">
                  <input className="inp" value={songTitle} onChange={e => setSongTitle(e.target.value)} placeholder="Song title..." />
                  <textarea className="inp" rows={8} value={lyricsText} onChange={e => setLyricsText(e.target.value)}
                    placeholder={"Paste lyrics...\nUse [Verse 1], [Chorus] for sections"} />
                </div>
              </div>
            </div>

            {/* Centre — Karaoke Stage */}
            <div className="stage">
              {renderDisplay()}
              <div className="stage-controls-bar">
                <button className={`btn large ${playing ? "danger" : "gold"}`} onClick={startKaraoke}>
                  {playing ? "⏹ Stop" : "▶ Start"}
                </button>
                {playing && (
                  <>
                    <button className="btn" onClick={() => setLyricIdx(i => Math.max(0, i-1))}>↑</button>
                    <button className="btn" onClick={() => setLyricIdx(i => Math.min(parsedLines.length-1, i+1))}>↓</button>
                    <div className="progress-wrap"><div className="progress-fill" style={{ width: `${progress}%` }} /></div>
                    <div className="beat-viz">{beats.map((h, i) => <div key={i} className="beat-bar" style={{ height: h }} />)}</div>
                  </>
                )}
                <div style={{ flex: 1 }} />
                <button className="btn" onClick={() => setFullscreen(true)}>⛶ Projector</button>
              </div>
            </div>

            {/* Right — Settings */}
            <div className="right-panel">
              <div className="panel-section">
                <div className="section-label">Scroll Speed</div>
                <div className="row mt8">
                  <span className="small">Slow</span>
                  <input type="range" min="1" max="7" value={speed} onChange={e => setSpeed(Number(e.target.value))} />
                  <span className="small">Fast</span>
                  <span className="range-val">{speed}</span>
                </div>
              </div>
              <div className="panel-section">
                <BgUploader bg={musicBg} setter={setMusicBg} label="Stage Background" />
              </div>
              <div className="panel-section">
                <div className="section-label">Tips</div>
                <div className="gap6" style={{ fontSize: 12, color: "var(--muted)", lineHeight: 1.75 }}>
                  <div>• Use [Verse 1], [Chorus] labels</div>
                  <div>• Blank lines = natural pause</div>
                  <div>• Click any line to jump to it</div>
                  <div>• Save songs to library for reuse</div>
                  <div>• Hit Projector for fullscreen output</div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ══════════════════════════════ BIBLE MODE */}
        {mode === "bible" && (
          <div className="content">
            {/* Left — Search */}
            <div className="left-panel">
              <div className="panel-section">
                <div className="section-label">Bible Translation</div>
                <div className="version-tabs mt8">
                  {VERSIONS.map(v => (
                    <button key={v} className={`version-btn ${bibleVersion===v?"active":""}`} onClick={() => setBibleVersion(v)}>
                      {v.toUpperCase()}
                    </button>
                  ))}
                </div>
              </div>

              <div className="panel-section">
                <div className="section-label">Search Verse</div>
                <div className="gap8 mt8">
                  <input className="inp" value={bibleQuery}
                    onChange={e => setBibleQuery(e.target.value)}
                    onKeyDown={e => e.key === "Enter" && fetchVerse(bibleQuery)}
                    placeholder="e.g. John 3:16" />
                  <button className="btn gold full large" onClick={() => fetchVerse(bibleQuery)}>
                    {bibleLoading ? "Searching..." : "Search"}
                  </button>
                  {bibleError && <div style={{ fontSize: 12, color: "#ff8080" }}>{bibleError}</div>}
                </div>
              </div>

              <div className="panel-section">
                <div className="section-label">Quick Verses</div>
                <div className="recent-list mt8">
                  {["John 3:16","Psalm 23:1","Romans 8:28","Philippians 4:13","Proverbs 3:5","Isaiah 40:31","Matthew 28:19","Jeremiah 29:11"].map(v => (
                    <div key={v} className="recent-item" onClick={() => { setBibleQuery(v); fetchVerse(v); }}>
                      <span>{v}</span><span>→</span>
                    </div>
                  ))}
                </div>
              </div>

              {recentVerses.length > 0 && (
                <div className="panel-section">
                  <div className="section-label">Recent</div>
                  <div className="recent-list mt8">
                    {recentVerses.map((v, i) => (
                      <div key={i} className="recent-item" onClick={() => setBibleVerse(v)}>
                        <span>{v.reference}</span><span>→</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>

            {/* Centre — Verse Display */}
            <div className="stage">
              {renderDisplay()}
              <div className="stage-controls-bar">
                {bibleVerse && <span className="small">{bibleVerse.reference} · {bibleVersion.toUpperCase()}</span>}
                <div style={{ flex: 1 }} />
                <button className="btn" onClick={() => setFullscreen(true)}>⛶ Projector</button>
              </div>
            </div>

            {/* Right — Settings */}
            <div className="right-panel">
              <div className="panel-section">
                <BgUploader bg={bibleBg} setter={setBibleBg} label="Stage Background" />
              </div>
              <div className="panel-section">
                <div className="section-label">Display Tips</div>
                <div className="gap6" style={{ fontSize: 12, color: "var(--muted)", lineHeight: 1.75 }}>
                  <div>• Press Enter to search quickly</div>
                  <div>• Click quick verses for instant display</div>
                  <div>• Recent verses stay for the session</div>
                  <div>• Hit Projector for fullscreen</div>
                  <div>• Translations: WEB, KJV, ASV, BBE</div>
                </div>
              </div>
              <div className="panel-section">
                <div className="section-label">About Translations</div>
                <div className="gap6" style={{ fontSize: 11, color: "var(--muted)", lineHeight: 1.75 }}>
                  <div><b style={{ color: "var(--gold)" }}>WEB</b> — World English Bible</div>
                  <div><b style={{ color: "var(--gold)" }}>KJV</b> — King James Version</div>
                  <div><b style={{ color: "var(--gold)" }}>ASV</b> — American Standard</div>
                  <div><b style={{ color: "var(--gold)" }}>BBE</b> — Bible in Basic English</div>
                </div>
              </div>
            </div>
          </div>
        )}

      </div>
    </>
  );
}
